<?xml version="1.0" encoding="UTF-8"?>
<Widget version="2" screenWidth="1080" resDensity="480" frameRate="0" scaleByDensity="false" customizedDarkModeWallpaper="true" extraResources="sw1440:den560:1">
    <ExternalCommands>
      <Trigger action="init,resume">
        <BinderCommand name="request" command="refresh"/>
        <AnimationCommand target="fra" command="play"/>
      </Trigger>
    </ExternalCommands>

    <!-- 帧率控制 -->
    <FramerateController name="fra" initPause="true" loop="false">
      <ControlPoint frameRate="10" time="0"/>
      <ControlPoint frameRate="10" time="500"/>
      <ControlPoint frameRate="0" time="600"/>
    </FramerateController>

    <!-- templateCode -->
    <Var name="templateCode" expression="'alipay'" type="string" const="true"/>
    <!-- contentCode -->
    <Var name="contentCode" expression="'alipay_live'" type="string" const="true"/>
    <!-- 埋点数据 -->
    <!-- 背景图：1,行动点1：2, 行动点2：3, 右侧按钮1：4, 右侧按钮2：5 -->
    <Var name="trackNumber" expression="'{&quot;self_component_item_location&quot;:&quot;__location&quot;}'" type="string"/>


  <!-- 变量绑定器：用于从外部数据绑定到变量 -->
  <VariableBinders>
     <!-- 请求云控数据 -->
     <ContentProviderBinder name="request" uriFormat="content://com.miui.personalassistant.maml.expand.cloud.data?localId=%s&amp;templateCode=%s&amp;contentCode=%s" uriParas="@customEditLocalId,@templateCode,@contentCode" columns="maMlCloudData,status" queryAtStart="false">
        <Variable name="maMlCloudData" type="string" column="maMlCloudData"/>
        <Variable name="networkStatus" type="number" column="status"/>
         <Trigger>
           <VariableCommand name="json" type="jsonO" expression="strToJson(@maMlCloudData)"/>
           <IfCommand ifCondition="#networkStatus == 1">
             <Consequent>
               <VariableCommand name="isLoaded" expression="1" type="number" />
               <!-- 根据imgList 拿到json数组 -->
               <VariableCommand name="imgList" type="jsonA" expression="jsonGetArray($json,'imgList')"/>
               <VariableCommand name="imgListLength" type="int" expression="getJsonArrayLength($$imgList)"/>

               <VariableCommand name="contentObj" type="jsonO" expression="jsonGetObject($json,'content')"/>
               <!-- 根据 actionPoint 拿到json数组 -->
               <!-- 每次请求接口后重置 -->
               <VariableCommand name="actionPointList" expression="newJsonArray()" type="jsonA" const="true" />
               <VariableCommand name="actionPointList" type="jsonA" expression="jsonGetArray($json,'actionPoint')"/>
               <VariableCommand name="buttonLinkList" type="jsonA" expression="jsonGetArray($json,'rightButtonLink')"/>

               <!-- 图片列表 -->
               <!-- 每次请求，初始化图片对象，避免在内存中复用上一次接口数据 -->
               <VariableCommand name="banner" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="darkBanner" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="logo" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="titleIcon" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="action0" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="action1" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="rightButton0" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="rightButton1" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="darkRightButton0" expression="newJsonObject()" type="jsonO" const="true" />
               <VariableCommand name="darkRightButton1" expression="newJsonObject()" type="jsonO" const="true" />

               <!-- 循环赋值 图片 -->
                <LoopCommand count="#imgListLength" indexName="img">
                    <VariableCommand nameExp="jsonGetString(jsonArrayGetIndex($$imgList, #img), 'name')" type="string" expression="jsonGetString(jsonArrayGetIndex($$imgList, #img), 'fileUri')" />
                </LoopCommand>

               <VariableCommand name="bannerLink" type="string" expression="''" />
               <VariableCommand name="bannerLink" type="string" expression="jsonGetString($json,'bannerLink')" condition="!strIsEmpty(jsonGetString($json,'bannerLink'))"/>

               <VariableCommand name="darkBanner" type="string" expression="@dark_banner" condition="strIsEmpty(@darkBanner)"/>


               <VariableCommand name="buttonJumpLink" expression="''" type="string[]" size="2" values="'',''" />
               <LoopCommand count="2" indexName="btn_i">
                   <!-- 重置默认值 -->
                   <VariableCommand name="buttonJumpLink" type="string[]" index="#btn_i" expression="@defaultJumpLink[#btn_i]"/>
                   <VariableCommand name="buttonJumpLink" type="string[]" index="#btn_i" expression="jsonGetString(jsonArrayGetIndex($$buttonLinkList,#btn_i), 'link')" condition="!strIsEmpty(jsonGetString(jsonArrayGetIndex($$buttonLinkList,#btn_i), 'link'))"/>
               </LoopCommand>

               <!-- 文本内容、颜色  -->
               <VariableCommand name="desc" type="string" expression="jsonGetString($contentObj,'desc')" />
               <VariableCommand name="descColor" type="string" expression="jsonGetString($contentObj,'descColor')" />
               <VariableCommand name="mainTitle" type="string" expression="jsonGetString($contentObj,'mainTitle')" />
               <VariableCommand name="mainColor" type="string" expression="jsonGetString($contentObj,'mainColor')" />
               <VariableCommand name="subTitle" type="string" expression="jsonGetString($contentObj,'subTitle')" />
               <VariableCommand name="subColor" type="string" expression="jsonGetString($contentObj,'subColor')" />

               <!-- 行动点 说明 -->
               <VariableCommand name="actionText0" type="string" expression="''" />
               <VariableCommand name="actionText1" type="string" expression="''" />
               <VariableCommand name="actionLink0" type="string" expression="''" />
               <VariableCommand name="actionLink1" type="string" expression="''" />
               <VariableCommand name="actionColor0" type="string" expression="''" />
               <VariableCommand name="actionColor1" type="string" expression="''" />
               <!-- ***规定循环次数为2次  i为指数名称用来标注循环计算次数的变量名 -->
               <LoopCommand count="2" indexName="_i">
                 <VariableCommand nameExp="'actionText'+#_i" type="string" expression="jsonGetString(jsonArrayGetIndex($$actionPointList,#_i), 'text')" condition="!strIsEmpty(jsonGetString(jsonArrayGetIndex($$actionPointList,#_i), 'text'))" />
                 <VariableCommand nameExp="'actionLink'+#_i" type="string" expression="jsonGetString(jsonArrayGetIndex($$actionPointList,#_i), 'link')" condition="!strIsEmpty(jsonGetString(jsonArrayGetIndex($$actionPointList,#_i), 'link'))"/>
                 <VariableCommand nameExp="'actionColor'+#_i" type="string" expression="jsonGetString(jsonArrayGetIndex($$actionPointList,#_i), 'color')" condition="!strIsEmpty(jsonGetString(jsonArrayGetIndex($$actionPointList,#_i), 'color'))"/>
               </LoopCommand>
               <!-- app下载链接 -->
               <VariableCommand name="appDownloadUrl" type="string" expression="jsonGetString($json, 'appDownloadUrl')"/>
               <AnimationCommand target="fra" command="play"/>
             </Consequent>
          </IfCommand>
         </Trigger>
     </ContentProviderBinder>
     <!-- 深色模式切换时，触发一次刷新 -->
    <BroadcastBinder action="android.intent.action.CONFIGURATION_CHANGED">
        <Trigger>
            <MethodCommand target="__objRoot" targetType="var" method="selfResume"/>
        </Trigger>
    </BroadcastBinder>
  </VariableBinders>

  <!-- 是否已加载成功数据 -->
  <Var name="isLoaded" type="number" expression="0" const="true" />
  <!-- 是否深色模式 -->
  <Var name="isDark" type="number" expression="#__darkmode" />
  <!-- 缩放比例 x -->
  <Var name="scaleX" type="number" expression="1" />
  <!-- 缩放比例 y -->
  <Var name="scaleY" type="number" expression="1" />
  <!-- 布局宽度 -->
  <Var name="width" type="number" expression="#view_width * #scaleX" />
  <!-- 布局高度 -->
  <Var name="height" type="number" expression="#view_height * #scaleY" />
  <Var name="padding" type="number" expression="40" const="true" />
  <!-- 整体内容布局大小 -->
  <Var name="layoutWidth" type="number" expression="#width-(2*#padding)" />
  <Var name="layoutHeight" type="number" expression="#height-(2*#padding)" />
  <Var name="logoSize" type="number" expression="42" const="true" />
  <Var name="actionSize" type="number[]" size="2" values="210,80" const="true" />
  <Var name="rightButtonWidth" type="number" expression="300" const="true" />
  <Var name="rightButtonHeight" type="number" expression="165" const="true" />
  <!-- 兜底图片、文字内容 -->
  <Var name="defaultLogo" type="string" expression="'images/logo.png'" const="true" />
  <Var name="defaultLightBg" expression="'images/Lightmode.png'" type="string" const="true" />
  <Var name="defaultDarkBg" expression="'images/Darkmode.png'" type="string" const="true" />

  <!-- 星期 切换语言问题 -->
  <Var name="week" expression="''" type="string[]" size="7" values="'日','一','二','三','四','五','六'" />

  <!-- 兜底图片、文字内容 -->
  <Var name="defaultBanner" type="string" expression="ifelse(#isDark,'images/Darkmode.png','images/Lightmode.png')" />
  <Var name="defaultDesc" expression="'你的生活小助手'" type="string" const="true" />
  <Var name="defaultTitle" expression="''" type="string[]" size="2" values="'MM月dd日','心怀期待，遇见美好'" />

  <!-- 兜底跳转 -->
  <!-- 背景图跳转link -->
  <Var name="defaultDP" expression="'alipays://platformapi/startapp?appId=20000001&amp;chInfo=ch_xiaomi_left_card&amp;sceneCode=KF_CHANGSHANG&amp;shareUserId=2088831085791813&amp;partnerId=ch_xiaomi_left_card'" type="string" const="true" />
  <!-- 右侧按钮跳转链接 -->
  <Var name="defaultJumpLink" expression="''" type="string[]" size="2" values="'alipays://platformapi/startapp?appId=20000056&amp;chInfo=ch_xiaomi_left_card&amp;sceneCode=KF_CHANGSHANG&amp;shareUserId=2088831085791813&amp;partnerId=ch_xiaomi_left_card','alipays://platformapi/startapp?appId=10000007&amp;chInfo=ch_xiaomi_left_card&amp;sceneCode=KF_CHANGSHANG&amp;shareUserId=2088831085791813&amp;partnerId=ch_xiaomi_left_card'" const="true" />

  <Var name="rightButtonLink0" type="string" expression="ifelse(strIsEmpty(@rightButton0_),@defaultJumpLink[0],@buttonJumpLink[0])" />
  <Var name="rightButtonLink1" type="string" expression="ifelse(strIsEmpty(@rightButton1_),@defaultJumpLink[1],@buttonJumpLink[1])" />

  <!-- 行动点数据列表(1个) -->
  <Var name="defaultAPJumpLink" expression="'alipays://platformapi/startapp?appId=20000001&amp;chInfo=ch_xiaomi_left_card&amp;sceneCode=KF_CHANGSHANG&amp;shareUserId=2088831085791813&amp;partnerId=ch_xiaomi_left_card'" type="string" const="true" />

  <!-- 图片素材 深浅切换 -->
  <Var name="defaultBgImage" type="string" expression="ifelse(#isDark,@defaultDarkBg,@defaultLightBg)" />
  <Var name="bgImage" type="string" expression="ifelse(#isDark,@darkBanner,@banner)" />
  <Var name="defaultButton0" type="string" expression="ifelse(#isDark,'images/darkButton0.png','images/button0.png')" />
  <Var name="defaultButton1" type="string" expression="ifelse(#isDark,'images/darkButton1.png','images/button1.png')" />
  <Var name="rightButton0_" type="string" expression="ifelse(#isDark,@darkRightButton0,@rightButton0)" />
  <Var name="rightButton1_" type="string" expression="ifelse(#isDark,@darkRightButton1,@rightButton1)" />

  <!-- 文本 -->
  <Var name="desc_" type="string" expression="ifelse(strIsEmpty(@desc),@defaultDesc,@desc)" />

  <!-- 文本颜色 深浅切换 -->
  <!-- 主标题 -->
  <Var name="mainColor_" type="string" expression="ifelse(#isDark,'#FFFFFF',ifelse(strIsEmpty(@mainColor),'#000000',@mainColor))" />
  <!-- 副标题 -->
  <Var name="subColor_" type="string" expression="ifelse(#isDark,'#99ffffff',ifelse(strIsEmpty(@subColor),'#99000000',@subColor))" />
  <!-- 卡片说明 -->
  <Var name="descColor_" type="string" expression="ifelse(#isDark,'#99ffffff',ifelse(strIsEmpty(@descColor),'#99000000',@descColor))" />
  <!-- 行动点 -->
  <Var name="actionText0_" type="string" expression="ifelse(strIsEmpty(@actionText0),'去看看',@actionText0)" />
  <Var name="actionLink0_" type="string" expression="ifelse(strIsEmpty(@actionLink0)||strIsEmpty(@action0),@defaultAPJumpLink,@actionLink0)" />

  <Var name="actionBg" type="string" expression="ifelse(#isDark,'#313132',ifelse(strIsEmpty(@action0),'#191677ff',''))" />
  <Var name="actionColor0_" type="string" expression="ifelse(#isDark,'#e5ffffff',ifelse(strIsEmpty(@actionColor0),'#ff1677ff',@actionColor0))" />
  <Var name="actionColor1_" type="string" expression="ifelse(#isDark,'#e5ffffff',ifelse(strIsEmpty(@actionColor1),'#ff1677ff',@actionColor1))" />

  <!-- 文本有效显示长度 -->
  <Var name="textShowWidth" type="number" expression="ifelse(strIsEmpty(@titleIcon),#layoutWidth-#rightButtonWidth-40,#layoutWidth-#rightButtonWidth-40-134)" />
  <!-- 是否有Icon图 -->
  <Var name="hasIcon" type="number" expression="ifelse(strIsEmpty(@titleIcon),0,134)" />

  <!-- 位置 变量 -->
  <Var name="titlePosition" type="number" expression=" (#layoutHeight-#logoSize-#actionSize[1]-104)/2" />
  <Var name="actionPosition" type="number" expression="#layoutHeight-#actionSize[1]-5" />
  <Var name="buttonPosition" type="number" expression="" />

  <!-- banner跳转链接 -->
  <Var name="bannerLink_" type="string" expression="ifelse(strIsEmpty(@bannerLink),@defaultDP,@bannerLink)" />

  <!-- banner -->
  <!-- 兜底banner -->
  <Image x="0" y="0" w="#width" h="#height" srcExp="@defaultBgImage" />
  <Image x="0" y="0" w="#width" h="#height" srcType="Uri" srcExp="@bgImage" visibility="!strIsEmpty(@banner)" />
  <Button x="0" y="0" w="#width" h="#height" interceptTouch="true" contentDescriptionExp="@defaultDesc">
      <Triggers>
        <Trigger action="up,double">
            <IntentCommand package="com.eg.android.AlipayGphone" action="android.intent.action.VIEW" uriExp="@bannerLink_">
                <Fallback>
                    <IntentCommand action="android.intent.action.VIEW" uriExp="@appDownloadUrl" condition="!strIsEmpty(@appDownloadUrl)" />
                </Fallback>
            </IntentCommand>
            <ExternCommand command="clickMaMlTrack" strPara="strReplaceFirst(@trackNumber, '__location', 1)"/>
        </Trigger>
      </Triggers>
  </Button>
  <!-- 左侧 区域 -->
  <Group x="#padding" y="#padding">
      <Image x="0" y="0" w="#logoSize" h="#logoSize" srcExp="@defaultLogo" visibility="strIsEmpty(@logo)"/>
      <Image x="0" y="0" w="#logoSize" h="#logoSize" srcExp="@logo" srcType="Uri" visibility="!strIsEmpty(@logo)"/>
      <!-- 卡片说明 -->
      <Text x="#logoSize+22" y="#logoSize/2" alignV="center" color="@descColor_" size="30" textExp="@desc_"/>
      <Group x="0" y="#logoSize+#titlePosition">
          <Group name="dateTime" x="0" y="0" visibility="strIsEmpty(@mainTitle)||strIsEmpty(@subTitle)">
            <DateTime x="0" y="0" color="@mainColor_" size="48" fontFamily="mipro-medium" enableFontScale="false" formatExp="@defaultTitle[0]" />
            <Text name="date" x="230" y="0" color="@mainColor_" size="48" fontFamily="mipro-medium" enableFontScale="false" textExp="'周'+@week[#day_of_week-1]"/>
            <Text x="0" y="#date.text_height+10" color="@subColor_" size="30" textExp="@defaultTitle[1]" />
          </Group>
          <Group visibility="!strIsEmpty(@mainTitle)**!strIsEmpty(@subTitle)">
            <!-- 标题icon -->
            <Image x="0" y="0" w="104" h="104" srcExp="@titleIcon" srcType="Uri" visibility="!strIsEmpty(@titleIcon)" />
            <!-- 主标题 -->
            <Text name="title_" x="#hasIcon" y="0" color="@mainColor_" size="48" textExp="@mainTitle" alpha="0"/>
            <Text x="#hasIcon" y="0" color="@mainColor_" size="48" textExp="ifelse(#title_.text_width}#textShowWidth,substr(@mainTitle,0,ceil((#textShowWidth-48*1.5)/48))+'...',@mainTitle)"/>
            <!-- 副标题 -->
            <Text name="subTitle_" x="#hasIcon" y="title_.text_height+5" color="@subColor_" size="30" textExp="@subTitle" alpha="0"/>
            <Text x="#hasIcon" y="#title_.text_height+8" color="@subColor_" size="30" textExp="ifelse(#subTitle_.text_width}#textShowWidth,substr(@subTitle,0,ceil((#textShowWidth-30*1.5)/30))+'...',@subTitle)"/>
          </Group>
      </Group>
      <Group x="0" y="#actionPosition">
          <!-- 第一个行动点 -->
          <Image x="0" y="0" w="210" h="80" srcType="Uri" srcExp="@action0" visibility="!#isDark**!strIsEmpty(@action0)" />
          <Rectangle x="0" y="0" w="210" h="80" fillColor="@actionBg" cornerRadius="14" visibility="#isDark || strIsEmpty(@action0)" />
          <Text x="210/2" y="80/2" align="center" alignV="center" color="@actionColor0_" size="30" textExp="ifelse(len(@actionText0_)}4,substr(@actionText0_,0,4)+'...',@actionText0_)+' >'"/>
          <Button x="0" y="0" w="#actionSize[0]" h="#actionSize[1]" interceptTouch="true" contentDescriptionExp="@actionText0_">
            <Triggers>
                <Trigger action="up">
                    <IntentCommand package="com.eg.android.AlipayGphone" action="android.intent.action.VIEW" uriExp="@actionLink0_">
                        <Fallback>
                            <IntentCommand action="android.intent.action.VIEW" uriExp="@appDownloadUrl" condition="!strIsEmpty(@appDownloadUrl)" />
                        </Fallback>
                    </IntentCommand>
                    <ExternCommand command="clickMaMlTrack" strPara="strReplaceFirst(@trackNumber, '__location', 2)"/>
                </Trigger>
            </Triggers>
          </Button>

          <!-- 绘制第二个行动点 -->
          <Group x="240"  y="0" visibility="!strIsEmpty(@action1)**!strIsEmpty(@actionText1)**!strIsEmpty(@actionLink1)">
              <Rectangle x="0" y="0" w="210" h="80" fillColor="#313132" cornerRadius="14" visibility="#isDark"/>
              <Image x="0" y="0" w="210" h="80" srcType="Uri" srcExp="@action1" visibility="!#isDark"/>
              <Text x="210/2" y="80/2" align="center" alignV="center" color="@actionColor1_" size="30" textExp="ifelse(len(@actionText1)}4,substr(@actionText1,0,4)+'...',@actionText1)+' >'"/>
              <Button x="0" y="0" w="#actionSize[0]" h="#actionSize[1]" interceptTouch="true" contentDescriptionExp="@actionText1">
                <Triggers>
                    <Trigger action="up">
                        <IntentCommand package="com.eg.android.AlipayGphone" action="android.intent.action.VIEW" uriExp="@actionLink1">
                            <Fallback>
                                <IntentCommand action="android.intent.action.VIEW" uriExp="@appDownloadUrl" condition="!strIsEmpty(@appDownloadUrl)" />
                            </Fallback>
                        </IntentCommand>
                        <ExternCommand command="clickMaMlTrack" strPara="strReplaceFirst(@trackNumber, '__location', 3)"/>
                    </Trigger>
                </Triggers>
              </Button>
          </Group>
      </Group>
  </Group>

  <!-- 右侧 区域 -->
  <Group x="#width-#padding-#rightButtonWidth" y="(#height-2*#rightButtonHeight)*8/11/2">
    <Image x="0" y="0" w="#rightButtonWidth" h="#rightButtonHeight" srcType="Uri" srcExp="@rightButton0_" visibility="!strIsEmpty(@rightButton0)**!strIsEmpty(@darkRightButton0)"/>
    <Image x="0" y="0" w="#rightButtonWidth" h="#rightButtonHeight" srcExp="@defaultButton0" visibility="strIsEmpty(@rightButton0)" />
    <Button x="0" y="0" w="#rightButtonWidth" h="#rightButtonHeight" interceptTouch="true" contentDescription="支付宝">
        <Triggers>
            <Trigger action="up">
                <IntentCommand package="com.eg.android.AlipayGphone" action="android.intent.action.VIEW" uriExp="@rightButtonLink0">
                    <Fallback>
                        <IntentCommand action="android.intent.action.VIEW" uriExp="@appDownloadUrl" condition="!strIsEmpty(@appDownloadUrl)" />
                    </Fallback>
                </IntentCommand>
                <ExternCommand command="clickMaMlTrack" strPara="strReplaceFirst(@trackNumber, '__location', 4)"/>
            </Trigger>
        </Triggers>
    </Button>
    <Image x="0" y="(#height-2*#rightButtonHeight)*3/11+#rightButtonHeight" w="#rightButtonWidth" h="#rightButtonHeight" srcType="Uri" srcExp="@rightButton1_" visibility="!strIsEmpty(@rightButton1)**!strIsEmpty(@darkRightButton1)"/>
    <Image x="0" y="(#height-2*#rightButtonHeight)*3/11+#rightButtonHeight" w="#rightButtonWidth" h="#rightButtonHeight" srcExp="@defaultButton1" visibility="strIsEmpty(@rightButton1)" />
    <Button x="0" y="(#height-2*#rightButtonHeight)*3/11+#rightButtonHeight" w="#rightButtonWidth" h="#rightButtonHeight" interceptTouch="true" contentDescription="支付宝">
        <Triggers>
            <Trigger action="up">
                <IntentCommand package="com.eg.android.AlipayGphone" action="android.intent.action.VIEW" uriExp="@rightButtonLink1">
                    <Fallback>
                        <IntentCommand action="android.intent.action.VIEW" uriExp="@appDownloadUrl" condition="!strIsEmpty(@appDownloadUrl)" />
                    </Fallback>
                </IntentCommand>
                <ExternCommand command="clickMaMlTrack" strPara="strReplaceFirst(@trackNumber, '__location', 5)"/>
            </Trigger>
        </Triggers>
    </Button>
  </Group>
</Widget>